# Database
POSTGRES__USER=skillhub
POSTGRES__PASSWORD=change-me
POSTGRES__DB=skillhub

# SkillSpector 后端访问 Jenkins 的凭据（注入 api 容器，用于调用 Jenkins 接口）。
# 注意：Jenkins 自身的部署参数（http 端口、executor 数、quiet period、仓库根目录、
# admin 密码）与大模型复核参数（模型、API Key、调用节点、限流、并发、超时等）
# 统一在 config.yaml 的 security.skillspector_* 字段中管理，不再通过环境变量设置。
# 此处 TOKEN 必须与 config.yaml 的 security.skillspector_jenkins_token 保持一致。
SECURITY__SKILLSPECTOR_JENKINS_URL=http://skillspector:8083
SECURITY__SKILLSPECTOR_JENKINS_USER=admin
SECURITY__SKILLSPECTOR_JENKINS_TOKEN=change-me

# 后台定时 LLM 复核（每天 01:00-08:00，北京时间）：
# 复核数据库中未复核过的 SkillSpector 风险项，剔除误报并重算分数。
# model/base_url/api_key 留空时复用 model.providers 当前 provider
# （默认 siliconflow / Qwen3.5-4B）；需要单独指定复核模型时再覆盖。
# 全部为空则任务自动跳过，仅记录告警，不影响 API 启动。
# AUDIT_LLM_REVIEW__MODEL=
# AUDIT_LLM_REVIEW__BASE_URL=
# AUDIT_LLM_REVIEW__API_KEY=
# AUDIT_LLM_REVIEW__START_TIME=01:00
# AUDIT_LLM_REVIEW__END_TIME=08:00
# AUDIT_LLM_REVIEW__CONCURRENCY=3
# 置信度门槛：确认为真但 confidence 低于该值的命中按上游 SkillSpector 口径丢弃；0=关闭。
# AUDIT_LLM_REVIEW__MIN_CONFIDENCE=0.6
# 误报删除门槛：模型判定 false 但 confidence 低于该值时不删除；HIGH/CRITICAL 用 *_high；0=关闭。
# AUDIT_LLM_REVIEW__MIN_FALSE_POSITIVE_CONFIDENCE=0.85
# AUDIT_LLM_REVIEW__MIN_FALSE_POSITIVE_CONFIDENCE_HIGH=0.9
# 单次输出上限：每批命中只返回 index/is_vulnerability/confidence/reason。
# AUDIT_LLM_REVIEW__MAX_OUTPUT_TOKENS=2048
# 上下文：本地 repo 缓存优先 -> 远端 raw -> snippet。
# context_mode 可选 snippet / window / full；window 对小文件送全文、大文件取窗口行。
# AUDIT_LLM_REVIEW__CONTEXT_MODE=window
# AUDIT_LLM_REVIEW__WINDOW_LINES=40
# AUDIT_LLM_REVIEW__REPO_CACHE_ROOT=/opt/wittyhub/skill-repositories
# AUDIT_LLM_REVIEW__REMOTE_FETCH_ENABLED=true
# 私仓 token（公开仓库留空即可）；远端失败/超时会自动回退 snippet。
# AUDIT_LLM_REVIEW__GITHUB_TOKEN=
# AUDIT_LLM_REVIEW__GITCODE_TOKEN=
# AUDIT_LLM_REVIEW__GITLAB_TOKEN=
# AUDIT_LLM_REVIEW__GITEE_TOKEN=

# Optional embedding model
# AI__EMBEDDING_HOST=http://embedding:8082
